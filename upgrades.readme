# for main.py, in main loop, before flip (refresh)        
    player.radius *= 1.1

    # scale the sprite/image and rect if you draw from an image
    w, h = player.image.get_size()
    new_size = (int(w * 1.1), int(h * 1.1))
    player.image = pygame.transform.smoothscale(player.image, new_size)
    player.rect = player.image.get_rect(center=player.rect.center)
    break

# different objects for nonplayer.py; alien ship enemy? alienshipfield.py
Different Spawn Rates: Alien ships might appear
more or less frequently than asteroids.
Different Velocity Ranges: They might move faster or slower.
Different Initial Properties: Alien ships might have
different starting health, weapons, or even different
shapes than asteroids.
Distinct spawn method: The spawn method would create
an AlienShip object, not an Asteroid.


